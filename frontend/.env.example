# Leave empty for the static (WhatsApp-only) build: content comes from src/lib/content.seed.ts.
# "/"  → production: the API is on this same site via the /api reverse proxy (functions/api).
#        Never the workers.dev URL: cross-site login cookies are dropped (ARCHITECTURE.md §02).
# URL  → call an API directly, e.g. local dev: http://localhost:8787
VITE_API_URL=
# The public address, for canonical and Open Graph URLs. Defaults to whatever origin serves the page.
VITE_SITE_URL=
