# Copy to backend/.env (gitignored). Read by the Wrangler TOOL, so no `wrangler login` is needed.
# Never merge with .dev.vars: the running API must not hold the account token.
# Token: Cloudflare → Manage Account → Account API Tokens → custom token with
#        Workers Scripts: Edit, D1: Edit, Cloudflare Pages: Edit. Same token as the GitHub secret.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
