{
  "name": "ganga-vedha-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --remote",
    "typecheck": "tsc --noEmit",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply ganga-vedha-db --remote",
    "deploy": "wrangler d1 migrations apply ganga-vedha-db --remote && wrangler deploy"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@neondatabase/serverless": "^1.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "wrangler": "^4.147.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
